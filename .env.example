# ── Supabase (new project — NOT the Prism project) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (same key as Prism is fine — this is model access only,
#    no data store, so it doesn't create a conflation risk) ─────────
ANTHROPIC_API_KEY=

# ── Stripe (same account as Prism is fine; use a separate Product
#    and a separate webhook endpoint so credit pools never cross) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_RESUME_PACK=

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_ORG_ID=
NEXT_PUBLIC_DEMO_REQUISITION_ID=
